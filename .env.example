# ====================================================
#  متغيرات البيئة - TilalWeb
# ====================================================
# انسخ هذا الملف إلى .env.local وأدخل قيمك الخاصة

# -------------------------------------------------------
# ImageKit - رفع الصور وإدارتها
# -------------------------------------------------------
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key_here"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key_here"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint_here"
NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/your_endpoint_here"

# -------------------------------------------------------
# Admin Panel - حماية لوحة التحكم
# -------------------------------------------------------
ADMIN_PASSWORD="your_admin_password_here"
ADMIN_TOKEN_SECRET="your_secret_admin_token_here"

# -------------------------------------------------------
# App URL - رابط الموقع (للـ sitemap والـ SEO)
# -------------------------------------------------------
APP_URL="https://yourdomain.com"
